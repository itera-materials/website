---
// Page shell: head, language alternates, social preview, organisation data for search engines and,
// when switched on, GoatCounter (D022). The page imports the design-system stylesheet (inlined).
import favicon from "../../vendor/design-system/dist/logo/itera-favicon.svg?url";
import { GOATCOUNTER_INTEGRITY, GOATCOUNTER_SCRIPT, goatcounterEndpoint } from "../analytics";

interface Props {
  lang: "en" | "fr";
  title: string;
  description: string;
  ogDescription: string;
  paths: { en: string; fr: string };
}

const { lang, title, description, ogDescription, paths } = Astro.props;
const url = (l: "en" | "fr") => new URL(paths[l], Astro.site).href;
const site = new URL("/", Astro.site).href;
const organisation = {
  "@context": "https://schema.org",
  "@type": "Organization",
  name: "Itera Materials",
  url: site,
  logo: new URL("/logo.png", Astro.site).href,
  email: "contact@iteramaterials.com",
  description,
  sameAs: ["https://www.linkedin.com/company/itera-materials/"],
};
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={url(lang)} />
    <link rel="alternate" hreflang="en" href={url("en")} />
    <link rel="alternate" hreflang="fr" href={url("fr")} />
    <link rel="alternate" hreflang="x-default" href={url("en")} />
    <meta property="og:title" content="Itera Materials" />
    <meta property="og:description" content={ogDescription} />
    <meta property="og:url" content={url(lang)} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={lang === "fr" ? "fr_FR" : "en_GB"} />
    <meta property="og:image" content={new URL("/og.png", Astro.site).href} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Itera Materials · Recycled carbon fibre" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" href={favicon} type="image/svg+xml" />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(organisation)} />
    {goatcounterEndpoint && (
      <script
        is:inline
        async
        data-goatcounter={goatcounterEndpoint}
        src={GOATCOUNTER_SCRIPT}
        crossorigin="anonymous"
        integrity={GOATCOUNTER_INTEGRITY}
      ></script>
    )}
  </head>
  <body>
    <slot />
  </body>
</html>
