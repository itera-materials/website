---
// Classic version (live at / and /fr/, D019): text from src/content/home/<lang>.yaml, style from
// design-system 0.1 (vendor/design-system-classic), logo from brand 1.0.
import "../../vendor/design-system-classic/dist/itera.css";
import { getEntry } from "astro:content";
import Base from "../layouts/Base.astro";
import logo from "../../vendor/design-system/dist/logo/itera-logo-on-dark.svg?url";

interface Props {
  lang: "en" | "fr";
}

const { lang } = Astro.props;
const entry = await getEntry("home", lang);
if (!entry) throw new Error(`missing src/content/home/${lang}.yaml`);
const t = entry.data;
const home = lang === "fr" ? "/fr/" : "/";
const languages = [
  { code: "en", label: "EN", href: "/" },
  { code: "fr", label: "FR", href: "/fr/" },
] as const;
const year = new Date().getFullYear();
---

<Base lang={lang} title={t.meta.title} description={t.meta.description} ogDescription={t.meta.ogDescription}>
  <a class="skip-link" href="#main">{t.skipLink}</a>

  <header class="site-header">
    <div class="wrap">
      <a class="brand" href={home}><img src={logo} alt="Itera Materials" width="81" height="44" /></a>
      <nav class="nav" aria-label={t.nav.label}>
        <a href="#approach">{t.nav.approach}</a>
        <a href="#partners">{t.nav.partners}</a>
        <a href="#contact">{t.nav.contact}</a>
        <span class="lang-switch" role="group" aria-label={t.nav.languages}>
          {languages.map((l) => (
            <a href={l.href} hreflang={l.code} lang={l.code} aria-current={l.code === lang ? "true" : undefined}>{l.label}</a>
          ))}
        </span>
      </nav>
    </div>
  </header>

  <main id="main">
    <section class="hero">
      <div class="wrap">
        <p class="eyebrow">{t.hero.eyebrow}</p>
        <h1>{t.hero.title}</h1>
        <p class="lead">{t.hero.lead}</p>
        <div class="actions">
          <a class="btn" href="#contact">{t.hero.primary}</a>
          <a class="btn btn--ghost" href="#approach">{t.hero.secondary}</a>
        </div>
      </div>
    </section>

    <section class="section">
      <div class="wrap split">
        <h2>{t.problem.title}</h2>
        <div>
          <p>{t.problem.body}</p>
          <p class="callout">{t.problem.callout}</p>
        </div>
      </div>
    </section>

    <section class="section section--alt" id="approach">
      <div class="wrap">
        <h2>{t.approach.title}</h2>
        <p class="intro">{t.approach.intro}</p>
        <ol class="steps">
          {t.approach.steps.map((s) => (
            <li class="step">
              <h3>{s.title}</h3>
              <p>{s.body}</p>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <section class="section" id="partners">
      <div class="wrap">
        <h2>{t.partners.title}</h2>
        <p class="intro">{t.partners.intro}</p>
        <div class="two-col">
          {t.partners.groups.map((g) => (
            <div>
              <h3>{g.title}</h3>
              <p>{g.body}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="section contact" id="contact">
      <div class="wrap">
        <h2>{t.contact.title}</h2>
        <p>{t.contact.body}</p>
        <a class="contact__mail" href="mailto:contact@iteramaterials.com">contact@iteramaterials.com</a>
      </div>
    </section>
  </main>

  <footer class="site-footer">
    <div class="wrap">
      <span>© {year} Itera Materials</span>
      <span>{t.footer.hosting}</span>
    </div>
  </footer>
</Base>
