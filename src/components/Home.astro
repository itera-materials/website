---
// The one-page site. Text comes from src/content/home/<lang>.yaml; style and logo only from the
// vendored design system (D020).
import "../../vendor/design-system/dist/itera.css";
import { getEntry } from "astro:content";
import Base from "../layouts/Base.astro";
import Footer from "./Footer.astro";
import Header from "./Header.astro";

interface Props {
  lang: "en" | "fr";
}

const { lang } = Astro.props;
const entry = await getEntry("home", lang);
if (!entry) throw new Error(`missing src/content/home/${lang}.yaml`);
const t = entry.data;
const paths = { en: "/", fr: "/fr/" };
---

<Base lang={lang} title={t.meta.title} description={t.meta.description} ogDescription={t.meta.ogDescription} paths={paths}>
  <Header lang={lang} paths={paths} />

  <main id="main">
    <section class="hero">
      <div class="wrap">
        <p class="eyebrow">{t.hero.eyebrow}</p>
        <h1>{t.hero.title}</h1>
        <p class="lead">{t.hero.lead}</p>
        <div class="actions">
          <a class="btn" href="#contact">{t.hero.primary}</a>
          <a class="btn btn--ghost" href="#approach">{t.hero.secondary}</a>
        </div>
      </div>
    </section>

    <section class="section">
      <div class="wrap split">
        <h2>{t.problem.title}</h2>
        <div>
          <p>{t.problem.body}</p>
          <p class="callout">{t.problem.callout}</p>
        </div>
      </div>
    </section>

    <section class="section section--alt" id="approach">
      <div class="wrap">
        <h2>{t.approach.title}</h2>
        <p class="intro">{t.approach.intro}</p>
        <ol class="steps">
          {t.approach.steps.map((s) => (
            <li class="step">
              <h3>{s.title}</h3>
              <p>{s.body}</p>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <section class="section" id="partners">
      <div class="wrap">
        <h2>{t.partners.title}</h2>
        <p class="intro">{t.partners.intro}</p>
        <div class="two-col">
          {t.partners.groups.map((g) => (
            <div>
              <h3>{g.title}</h3>
              <p>{g.body}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="section contact" id="contact">
      <div class="wrap">
        <h2>{t.contact.title}</h2>
        <p>{t.contact.body}</p>
        <a class="contact__mail" href="mailto:contact@iteramaterials.com" data-goatcounter-click="contact-email">contact@iteramaterials.com</a>
      </div>
    </section>
  </main>

  <Footer lang={lang} />
</Base>
