---
// Industrial version (preview at /preview/industrial/, not indexed, D019): text from
// src/content/home-industrial/<lang>.yaml, style from design-system 1.0.
import "../../vendor/design-system/dist/itera.css";
import { getEntry } from "astro:content";
import Base from "../layouts/Base.astro";
import logo from "../../vendor/design-system/dist/logo/itera-logo-on-dark.svg?raw";

interface Props {
  lang: "en" | "fr";
}

const { lang } = Astro.props;
const entry = await getEntry("homeIndustrial", lang);
if (!entry) throw new Error(`missing src/content/home-industrial/${lang}.yaml`);
const t = entry.data;
const paths = { en: "/preview/industrial/", fr: "/fr/preview/industrial/" };
const home = paths[lang];
const languages = [
  { code: "en", label: "EN", href: paths.en },
  { code: "fr", label: "FR", href: paths.fr },
] as const;
const year = new Date().getFullYear();
---

<Base lang={lang} title={t.meta.title} description={t.meta.description} ogDescription={t.meta.ogDescription} paths={paths} noindex>
  <a class="skip-link" href="#main">{t.skipLink}</a>

  <header class="site-header">
    <div class="wrap">
      <a class="brand" href={home}><Fragment set:html={logo} /></a>
      <nav class="nav" aria-label={t.nav.label}>
        <a href="#process">{t.nav.process}</a>
        <a href="#work">{t.nav.work}</a>
        <a href="#contact">{t.nav.contact}</a>
        <span class="lang-switch" role="group" aria-label={t.nav.languages}>
          {languages.map((l) => (
            <a href={l.href} hreflang={l.code} lang={l.code} aria-current={l.code === lang ? "true" : undefined}>{l.label}</a>
          ))}
        </span>
      </nav>
    </div>
  </header>

  <main id="main">
    <section class="hero">
      <svg class="hero__ring" viewBox="24 8 272 304" aria-hidden="true" focusable="false">
        <path d="M 263.9 142 L 263.9 220 L 160 280 L 56.1 220 L 56.1 100 L 160 40 L 228 79.3" fill="none" stroke="currentColor" stroke-width="30" stroke-linecap="round" stroke-linejoin="round"></path>
        <circle cx="263.9" cy="100" r="19" fill="currentColor"></circle>
      </svg>
      <div class="wrap">
        <p class="eyebrow">{t.hero.eyebrow}</p>
        <h1>{t.hero.title}</h1>
        <p class="lead">{t.hero.lead}</p>
        <div class="actions">
          <a class="btn" href="#work">{t.hero.primary}</a>
          <a class="btn btn--dark" href="#work">{t.hero.secondary}</a>
        </div>
      </div>
    </section>

    <section class="stats" aria-label={t.why.label}>
      <div class="wrap">
        <ul class="stats__list">
          {t.why.items.map((item, i) => (
            <li class:list={["stat", { "stat--accent": i % 2 === 1 }]}>
              <span class="stat__value">{item.value}</span>
              <span class="stat__label">{item.label}</span>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <section class="section">
      <div class="wrap split">
        <h2>{t.problem.title}</h2>
        <div>
          <p>{t.problem.body}</p>
          <p class="callout">{t.problem.callout}</p>
        </div>
      </div>
    </section>

    <section class="section section--alt" id="process">
      <div class="wrap">
        <h2>{t.approach.title}</h2>
        <p class="intro">{t.approach.intro}</p>
        <ol class="steps">
          {t.approach.steps.map((s) => (
            <li class="step">
              <h3>{s.title}</h3>
              <p>{s.body}</p>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <section class="section" id="work">
      <div class="wrap">
        <h2>{t.partners.title}</h2>
        <p class="intro">{t.partners.intro}</p>
        <div class="cards">
          {[t.partners.waste, t.partners.fibre].map((a, i) => (
            <div class:list={["card", { "card--carbon": i === 1 }]}>
              <h3>{a.title}</h3>
              <p>{a.body}</p>
              <ul class="list">{a.items.map((item) => <li>{item}</li>)}</ul>
              <p class="list__note">{a.note}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="section contact" id="contact">
      <div class="wrap">
        <h2>{t.contact.title}</h2>
        <p>{t.contact.body}</p>
        <a class="contact__mail" href="mailto:contact@iteramaterials.com">contact@iteramaterials.com</a>
      </div>
    </section>
  </main>

  <footer class="site-footer">
    <div class="wrap">
      <span>© {year} Itera Materials</span>
      <span>{t.footer.hosting}</span>
    </div>
  </footer>
</Base>
