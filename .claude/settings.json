{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(just *)",
      "Bash(uv run --frozen pytest *)",
      "Bash(uv run --frozen ruff *)",
      "Bash(uv sync *)",
      "Bash(uv lock *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(gh auth status *)",
      "Bash(gh repo list *)",
      "Bash(gh repo view *)",
      "Bash(gh api repos/itera-materials/*/pages *)",
      "Bash(dig *)"
    ],
    "ask": [
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(gh repo delete *)",
      "Bash(gh repo edit * --visibility *)"
    ],
    "deny": [
      "Bash(rclone sync *)",
      "Bash(rclone config show*)",
      "Bash(rclone config dump*)",
      "Bash(sops -d *)",
      "Bash(sops --decrypt *)",
      "Bash(sops decrypt *)",
      "Bash(sops exec-env *)",
      "Bash(sops exec-file *)",
      "Bash(printenv*)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/*.age.key)",
      "Read(**/*.pem)",
      "Read(~/.config/sops/age/**)",
      "Read(~/.config/rclone/**)"
    ]
  }
}
